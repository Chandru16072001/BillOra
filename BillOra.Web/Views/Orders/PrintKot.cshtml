@model RestaurantOrder
@{
    Layout = null;
    var store = (Store)ViewBag.Store;
    int batch = ViewBag.Batch;
    var batchItems = Model.Items.Where(i => i.KotBatch == batch).ToList();
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>KOT @Model.OrderNumber - Batch @batch</title>
    <style>
        body { font-family: 'Courier New', monospace; width: 280px; margin: 0 auto; font-size: 15px; }
        h2, h3 { text-align: center; margin: 4px 0; }
        table { width: 100%; border-collapse: collapse; margin-top: 8px; }
        td, th { padding: 4px 0; }
        .right { text-align: right; }
        hr { border-top: 1px dashed #000; }
        .notes { font-style: italic; font-size: 13px; }
    </style>
</head>
<body onload="window.print()">
    <h2>KITCHEN ORDER TICKET</h2>
    <h3>KOT #@batch</h3>
    <hr />
    <p>
        Order: @Model.OrderNumber<br />
        Type: @Model.OrderType<br />
        @if (Model.Table != null) { <text>Table: @Model.Table.TableNumber<br /></text> }
        @if (Model.Waiter != null) { <text>Waiter: @Model.Waiter.Name<br /></text> }
        Time: @DateTime.Now.ToString("dd MMM yyyy hh:mm tt")
    </p>
    <hr />
    <table>
        <thead><tr><th>Item</th><th class="right">Qty</th></tr></thead>
        <tbody>
        @foreach (var oi in batchItems)
        {
            <tr>
                <td>
                    @oi.Item?.Name
                    @if (!string.IsNullOrEmpty(oi.Notes))
                    {
                        <div class="notes">* @oi.Notes</div>
                    }
                </td>
                <td class="right">@oi.Quantity</td>
            </tr>
        }
        </tbody>
    </table>
    <hr />
</body>
</html>

@{
    ViewData["Title"] = "New GRN";
    var vendors = (IEnumerable<Vendor>)ViewBag.Vendors;
}
@Html.AntiForgeryToken()

<h3 class="mb-4">New GRN (Goods Receipt Note)</h3>

<div class="pos-grid">
    <div>
        <div class="bo-card mb-3">
            <input id="itemSearch" class="form-control form-control-lg" placeholder="Search item by name, code, or barcode..." autofocus />
        </div>
        <div id="itemGrid" class="row g-2"></div>
    </div>

    <div>
        <div class="bo-card">
            <div class="mb-2">
                <label class="form-label small mb-1">Vendor</label>
                <select id="vendorSelect" class="form-select form-select-sm">
                    <option value="">-- select vendor --</option>
                    @foreach (var v in vendors)
                    {
                        <option value="@v.Id">@v.Name</option>
                    }
                </select>
            </div>
            <div class="mb-3">
                <label class="form-label small mb-1">Vendor Invoice No. (optional)</label>
                <input id="invoiceNumber" class="form-control form-control-sm" placeholder="Auto-generated if left blank" />
            </div>

            <h5 class="mb-2"><i class="fa-solid fa-truck-loading"></i> Items Received</h5>
            <div id="cartLines" style="max-height:300px; overflow-y:auto;">
                <p class="text-muted small" id="emptyCartMsg">No items added yet.</p>
            </div>

            <hr />
            <div class="mb-2">
                <label class="form-label small mb-1">Overall Discount (₹)</label>
                <input id="overallDiscount" type="number" min="0" value="0" class="form-control form-control-sm" oninput="renderCart()" />
            </div>
            <div class="d-flex justify-content-between small"><span>Subtotal</span><span id="subTotal">₹0.00</span></div>
            <div class="d-flex justify-content-between small"><span>Tax</span><span id="taxTotal">₹0.00</span></div>
            <div class="d-flex justify-content-between fw-bold fs-5 mt-2"><span>Total</span><span id="grandTotal">₹0.00</span></div>

            <div class="d-grid mt-3">
                <button class="btn btn-primary btn-lg" onclick="saveGrn()"><i class="fa-solid fa-check"></i> Save GRN</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
let cart = [];

function addToCart(id, name, price, gstPercent) {
    const existing = cart.find(l => l.itemId === id);
    if (existing) { existing.quantity += 1; }
    else { cart.push({ itemId: id, name: name, unitPrice: price, quantity: 1, discount: 0, gstPercent: gstPercent }); }
    renderCart();
}

function removeLine(idx) { cart.splice(idx, 1); renderCart(); }
function updateQty(idx, qty) {
    qty = parseFloat(qty);
    if (isNaN(qty) || qty <= 0) { cart.splice(idx, 1); } else { cart[idx].quantity = qty; }
    renderCart();
}
function updatePrice(idx, price) {
    price = parseFloat(price);
    cart[idx].unitPrice = isNaN(price) ? 0 : price;
    renderCart();
}

function renderCart() {
    const container = document.getElementById('cartLines');

    if (cart.length === 0) {
        container.innerHTML = '<p class="text-muted small" id="emptyCartMsg">No items added yet.</p>';
        document.getElementById('subTotal').innerText = '₹0.00';
        document.getElementById('taxTotal').innerText = '₹0.00';
        document.getElementById('grandTotal').innerText = '₹0.00';
        return;
    }

    let subTotal = 0, taxTotal = 0;
    let html = '';

    cart.forEach((line, idx) => {
        const lineBase = (line.unitPrice * line.quantity) - line.discount;
        const lineTax = lineBase * line.gstPercent / 100;
        subTotal += lineBase; taxTotal += lineTax;

        html += `
            <div class="pos-cart-line">
                <div class="d-flex justify-content-between">
                    <span class="fw-semibold">${line.name}</span>
                    <button class="btn btn-sm btn-link text-danger p-0" onclick="removeLine(${idx})"><i class="fa-solid fa-xmark"></i></button>
                </div>
                <div class="d-flex justify-content-between align-items-center mt-1 gap-1">
                    <input type="number" min="0.01" step="0.01" value="${line.quantity}" class="form-control form-control-sm" style="width:70px" onchange="updateQty(${idx}, this.value)" />
                    <input type="number" min="0" step="0.01" value="${line.unitPrice}" class="form-control form-control-sm" style="width:90px" onchange="updatePrice(${idx}, this.value)" />
                    <span class="fw-semibold">₹${(lineBase + lineTax).toFixed(2)}</span>
                </div>
            </div>`;
    });

    container.innerHTML = html;

    const overallDiscount = parseFloat(document.getElementById('overallDiscount').value) || 0;
    const grandTotal = subTotal - overallDiscount + taxTotal;
    document.getElementById('subTotal').innerText = '₹' + subTotal.toFixed(2);
    document.getElementById('taxTotal').innerText = '₹' + taxTotal.toFixed(2);
    document.getElementById('grandTotal').innerText = '₹' + grandTotal.toFixed(2);
}

document.getElementById('itemSearch').addEventListener('input', async function () {
    const term = this.value;
    if (!term) { document.getElementById('itemGrid').innerHTML = ''; return; }
    const res = await fetch('/Purchases/SearchItems?term=' + encodeURIComponent(term));
    const results = await res.json();
    const grid = document.getElementById('itemGrid');
    grid.innerHTML = '';
    results.forEach(i => {
        grid.innerHTML += `
            <div class="col-6 col-md-4 col-lg-3">
                <div class="pos-item-card" onclick="addToCart(${i.id}, '${i.name.replace("'", "\\'")}', ${i.purchasePrice}, ${i.gstPercent})">
                    <div class="fw-semibold">${i.name}</div>
                    <div class="text-muted small">Current stock: ${i.currentStock}</div>
                    <div class="text-primary fw-bold">Last cost ₹${i.purchasePrice.toFixed(2)}</div>
                </div>
            </div>`;
    });
});

async function saveGrn() {
    const vendorId = document.getElementById('vendorSelect').value;
    if (!vendorId) { alert('Select a vendor first.'); return; }
    if (cart.length === 0) { alert('Add at least one item.'); return; }

    const payload = {
        vendorId: parseInt(vendorId),
        invoiceNumber: document.getElementById('invoiceNumber').value || null,
        overallDiscount: parseFloat(document.getElementById('overallDiscount').value) || 0,
        lines: cart.map(l => ({ itemId: l.itemId, quantity: l.quantity, unitPrice: l.unitPrice, discount: l.discount, gstPercent: l.gstPercent }))
    };

    const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
    const res = await fetch('/Purchases/CreateGrn', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': token || '' },
        body: JSON.stringify(payload)
    });

    if (res.ok) {
        const result = await res.json();
        alert('GRN ' + result.invoiceNumber + ' saved. Stock updated.');
        window.location.href = '/Purchases/Details/' + result.purchaseId;
    } else {
        alert('Could not save the GRN. Please try again.');
    }
}
</script>
}

@{
    ViewData["Title"] = "New GRN";
    var vendors = (IEnumerable<Vendor>)ViewBag.Vendors;
    bool batchTrackingEnabled = ViewBag.BatchTrackingEnabled;
}
@Html.AntiForgeryToken()

<h3 class="mb-3">New GRN (Goods Receipt Note)</h3>

<div class="billing-tabs">
    <div class="tab-btn active" id="tabItemsBtn" onclick="switchTab('items')"><i class="fa-solid fa-magnifying-glass"></i> Items</div>
    <div class="tab-btn" id="tabCartBtn" onclick="switchTab('cart')"><i class="fa-solid fa-truck-loading"></i> Received <span class="tab-count" id="cartCountBadge">0</span></div>
</div>

<div class="billing-shell">
    <div class="billing-pane active" id="billingItemsPane">
        <div class="bo-card mb-3">
            <input id="itemSearch" class="form-control form-control-lg" placeholder="Search item by name, code, or barcode..." autofocus />
        </div>
        <div id="itemGrid" class="row g-2"></div>
    </div>

    <div class="billing-pane" id="billingCartPane">
        <div class="bo-card">
            <div class="mb-2">
                <label class="form-label small mb-1">Vendor</label>
                <select id="vendorSelect" class="form-select">
                    <option value="">-- select vendor --</option>
                    @foreach (var v in vendors)
                    {
                        <option value="@v.Id">@v.Name</option>
                    }
                </select>
            </div>
            <div class="mb-3">
                <label class="form-label small mb-1">Vendor Invoice No. (optional)</label>
                <input id="invoiceNumber" class="form-control" placeholder="Auto-generated if left blank" />
            </div>

            <h5 class="mb-2 d-none d-lg-block"><i class="fa-solid fa-truck-loading"></i> Items Received</h5>
            <div id="cartLines" style="max-height:34vh; overflow-y:auto;">
                <p class="text-muted small" id="emptyCartMsg">No items added yet. Switch to Items to start receiving stock.</p>
            </div>

            <hr />
            <div class="mb-2">
                <label class="form-label small mb-1">Overall Discount (₹)</label>
                <input id="overallDiscount" type="number" min="0" value="0" class="form-control" oninput="renderCart()" />
            </div>
            <div class="d-flex justify-content-between small"><span>Subtotal</span><span id="subTotal">₹0.00</span></div>
            <div class="d-flex justify-content-between small"><span>Tax</span><span id="taxTotal">₹0.00</span></div>
            <div class="d-flex justify-content-between fw-bold fs-5 mt-2"><span>Total</span><span id="grandTotal">₹0.00</span></div>

            <div class="d-grid gap-2 mt-3">
                <button class="btn btn-primary btn-lg" onclick="saveGrn()"><i class="fa-solid fa-check"></i> Save GRN</button>
                <button class="btn btn-outline-secondary d-lg-none" onclick="switchTab('items')"><i class="fa-solid fa-arrow-left"></i> Back to Items</button>
            </div>
        </div>
    </div>
</div>

<div class="billing-sticky-footer" id="stickyFooter" onclick="switchTab('cart')">
    <div>
        <div class="fw-bold" id="stickyItemCount">0 items</div>
        <div class="text-muted small" id="stickyTotal">₹0.00</div>
    </div>
    <button class="btn btn-primary"><i class="fa-solid fa-truck-loading"></i> View Receipt</button>
</div>

@section Scripts {
<script>
let cart = [];
let currentTab = 'items';
const batchTrackingEnabled = @Html.Raw(batchTrackingEnabled.ToString().ToLower());

function switchTab(tab) {
    currentTab = tab;
    document.getElementById('billingItemsPane').classList.toggle('active', tab === 'items');
    document.getElementById('billingCartPane').classList.toggle('active', tab === 'cart');
    document.getElementById('tabItemsBtn').classList.toggle('active', tab === 'items');
    document.getElementById('tabCartBtn').classList.toggle('active', tab === 'cart');
    updateStickyFooter();
    if (tab === 'items') window.scrollTo({ top: 0, behavior: 'smooth' });
}

function updateStickyFooter() {
    const footer = document.getElementById('stickyFooter');
    const show = currentTab === 'items' && cart.length > 0 && window.innerWidth < 992;
    footer.classList.toggle('visible', show);
}
window.addEventListener('resize', updateStickyFooter);

function addToCart(id, name, price, gstPercent) {
    const existing = cart.find(l => l.itemId === id);
    if (existing) { existing.quantity += 1; }
    else {
        cart.push({
            itemId: id, name: name, unitPrice: price, quantity: 1, discount: 0, gstPercent: gstPercent,
            batchNumber: '', manufactureDate: '', expiryDate: '', supplierBatchNumber: '', sellingRate: '', batchRemarks: ''
        });
    }
    renderCart();
    syncItemCardBadges();
}

function removeLine(idx) { cart.splice(idx, 1); renderCart(); syncItemCardBadges(); }
function stepQty(idx, delta) {
    const newQty = Math.round((cart[idx].quantity + delta) * 100) / 100;
    if (newQty <= 0) { cart.splice(idx, 1); } else { cart[idx].quantity = newQty; }
    renderCart();
    syncItemCardBadges();
}
function updateQty(idx, qty) {
    qty = parseFloat(qty);
    if (isNaN(qty) || qty <= 0) { cart.splice(idx, 1); } else { cart[idx].quantity = qty; }
    renderCart();
    syncItemCardBadges();
}
function updatePrice(idx, price) {
    price = parseFloat(price);
    cart[idx].unitPrice = isNaN(price) ? 0 : price;
    renderCart();
}
function updateBatchField(idx, field, value) {
    cart[idx][field] = value;
}
function toggleLineDetails(idx) {
    document.getElementById('lineDetails_' + idx)?.classList.toggle('expanded');
}

function syncItemCardBadges() {
    document.querySelectorAll('.pos-item-card').forEach(card => {
        const id = parseInt(card.dataset.itemId);
        const line = cart.find(l => l.itemId === id);
        const badge = card.querySelector('.pos-item-in-cart-badge');
        if (!badge) return;
        if (line) { badge.style.display = 'flex'; badge.innerText = line.quantity; }
        else { badge.style.display = 'none'; }
    });
}

function renderCart() {
    const container = document.getElementById('cartLines');

    if (cart.length === 0) {
        container.innerHTML = '<p class="text-muted small" id="emptyCartMsg">No items added yet. Switch to Items to start receiving stock.</p>';
        document.getElementById('subTotal').innerText = '₹0.00';
        document.getElementById('taxTotal').innerText = '₹0.00';
        document.getElementById('grandTotal').innerText = '₹0.00';
        document.getElementById('cartCountBadge').innerText = '0';
        updateStickyFooter();
        return;
    }

    let subTotal = 0, taxTotal = 0, totalQty = 0, html = '';
    cart.forEach((line, idx) => {
        const lineBase = (line.unitPrice * line.quantity) - line.discount;
        const lineTax = lineBase * line.gstPercent / 100;
        subTotal += lineBase; taxTotal += lineTax; totalQty += line.quantity;

        html += `
            <div class="pos-cart-line">
                <div class="d-flex justify-content-between align-items-start">
                    <span class="fw-semibold">${line.name}</span>
                    <button class="btn btn-sm btn-link text-danger p-0" onclick="removeLine(${idx})"><i class="fa-solid fa-trash"></i></button>
                </div>
                <div class="d-flex justify-content-between align-items-center mt-2 flex-wrap gap-2">
                    <div class="qty-stepper">
                        <button type="button" onclick="stepQty(${idx}, -1)">−</button>
                        <input type="number" value="${line.quantity}" onchange="updateQty(${idx}, this.value)" />
                        <button type="button" onclick="stepQty(${idx}, 1)">+</button>
                    </div>
                    <span class="fw-bold">₹${(lineBase + lineTax).toFixed(2)}</span>
                </div>
                <div class="mt-1">
                    <span class="billing-line-toggle" onclick="toggleLineDetails(${idx})"><i class="fa-solid fa-sliders"></i> ${batchTrackingEnabled ? 'Edit cost / batch details' : 'Edit cost price'}</span>
                    <div class="billing-line-details gap-2 mt-2 flex-wrap" id="lineDetails_${idx}">
                        <div class="flex-fill" style="min-width:100px;">
                            <label class="text-muted d-block" style="font-size:10px;">Unit Cost</label>
                            <input type="number" min="0" step="0.01" value="${line.unitPrice}" class="form-control form-control-sm" onchange="updatePrice(${idx}, this.value)" />
                        </div>
                        ${batchTrackingEnabled ? `
                        <div class="flex-fill" style="min-width:120px;">
                            <label class="text-muted d-block" style="font-size:10px;">Batch Number *</label>
                            <input type="text" value="${line.batchNumber}" class="form-control form-control-sm" onchange="updateBatchField(${idx}, 'batchNumber', this.value)" />
                        </div>
                        <div class="flex-fill" style="min-width:120px;">
                            <label class="text-muted d-block" style="font-size:10px;">Supplier Batch No.</label>
                            <input type="text" value="${line.supplierBatchNumber}" class="form-control form-control-sm" onchange="updateBatchField(${idx}, 'supplierBatchNumber', this.value)" />
                        </div>
                        <div class="flex-fill" style="min-width:120px;">
                            <label class="text-muted d-block" style="font-size:10px;">Mfg Date</label>
                            <input type="date" value="${line.manufactureDate}" class="form-control form-control-sm" onchange="updateBatchField(${idx}, 'manufactureDate', this.value)" />
                        </div>
                        <div class="flex-fill" style="min-width:120px;">
                            <label class="text-muted d-block" style="font-size:10px;">Expiry Date</label>
                            <input type="date" value="${line.expiryDate}" class="form-control form-control-sm" onchange="updateBatchField(${idx}, 'expiryDate', this.value)" />
                        </div>
                        <div class="flex-fill" style="min-width:100px;">
                            <label class="text-muted d-block" style="font-size:10px;">Selling Rate</label>
                            <input type="number" min="0" step="0.01" value="${line.sellingRate}" class="form-control form-control-sm" onchange="updateBatchField(${idx}, 'sellingRate', this.value)" />
                        </div>
                        <div class="flex-fill" style="min-width:140px;">
                            <label class="text-muted d-block" style="font-size:10px;">Remarks</label>
                            <input type="text" value="${line.batchRemarks}" class="form-control form-control-sm" onchange="updateBatchField(${idx}, 'batchRemarks', this.value)" />
                        </div>` : ''}
                    </div>
                </div>
            </div>`;
    });
    container.innerHTML = html;

    const overallDiscount = parseFloat(document.getElementById('overallDiscount').value) || 0;
    const grandTotal = subTotal - overallDiscount + taxTotal;
    document.getElementById('subTotal').innerText = '₹' + subTotal.toFixed(2);
    document.getElementById('taxTotal').innerText = '₹' + taxTotal.toFixed(2);
    document.getElementById('grandTotal').innerText = '₹' + grandTotal.toFixed(2);
    document.getElementById('cartCountBadge').innerText = cart.length;

    document.getElementById('stickyItemCount').innerText = totalQty + (totalQty === 1 ? ' item' : ' items');
    document.getElementById('stickyTotal').innerText = '₹' + grandTotal.toFixed(2);
    updateStickyFooter();
}

document.getElementById('itemSearch').addEventListener('input', async function () {
    const term = this.value;
    if (!term) { document.getElementById('itemGrid').innerHTML = ''; return; }
    const res = await fetch('/Purchases/SearchItems?term=' + encodeURIComponent(term));
    const results = await res.json();
    const grid = document.getElementById('itemGrid');
    grid.innerHTML = '';
    results.forEach(i => {
        grid.innerHTML += `
            <div class="col-6 col-md-4 col-lg-3">
                <div class="pos-item-card" data-item-id="${i.id}" onclick="addToCart(${i.id}, '${i.name.replace("'", "\\'")}', ${i.purchasePrice}, ${i.gstPercent})">
                    <span class="pos-item-in-cart-badge" style="display:none;">0</span>
                    <div class="fw-semibold">${i.name}</div>
                    <div class="text-muted small">Current stock: ${i.currentStock}</div>
                    <div class="text-primary fw-bold">Last cost ₹${i.purchasePrice.toFixed(2)}</div>
                </div>
            </div>`;
    });
    syncItemCardBadges();
});

async function saveGrn() {
    const vendorId = document.getElementById('vendorSelect').value;
    if (!vendorId) { alert('Select a vendor first.'); switchTab('cart'); return; }
    if (cart.length === 0) { alert('Add at least one item.'); return; }

    if (batchTrackingEnabled) {
        const missingBatch = cart.find(l => !l.batchNumber || !l.batchNumber.trim());
        if (missingBatch) { alert('Batch Tracking is enabled - enter a Batch Number for "' + missingBatch.name + '" before saving.'); return; }
    }

    const payload = {
        vendorId: parseInt(vendorId),
        invoiceNumber: document.getElementById('invoiceNumber').value || null,
        overallDiscount: parseFloat(document.getElementById('overallDiscount').value) || 0,
        lines: cart.map(l => ({
            itemId: l.itemId, quantity: l.quantity, unitPrice: l.unitPrice, discount: l.discount, gstPercent: l.gstPercent,
            batchNumber: l.batchNumber || null,
            manufactureDate: l.manufactureDate || null,
            expiryDate: l.expiryDate || null,
            supplierBatchNumber: l.supplierBatchNumber || null,
            sellingRate: l.sellingRate ? parseFloat(l.sellingRate) : null,
            batchRemarks: l.batchRemarks || null
        }))
    };

    const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
    const res = await fetch('/Purchases/CreateGrn', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': token || '' },
        body: JSON.stringify(payload)
    });

    if (res.ok) {
        const result = await res.json();
        alert('GRN ' + result.invoiceNumber + ' saved. Stock updated.');
        window.location.href = '/Purchases/Details/' + result.purchaseId;
    } else {
        alert('Could not save the GRN. Please try again.');
    }
}
</script>
}

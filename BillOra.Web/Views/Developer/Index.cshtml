@model List<Company>
@{ ViewData["Title"] = "Developer Portal"; }

<div class="d-flex justify-content-between align-items-center mb-4">
    <h3><i class="fa-solid fa-user-gear"></i> Companies &amp; Subscriptions</h3>
    <a class="btn btn-primary" href="/Developer/Create"><i class="fa-solid fa-plus"></i> Add Client</a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success py-2">@TempData["Success"]</div>
}

<div class="bo-card">
    <table class="table align-middle">
        <thead>
        <tr>
            <th>Company</th><th>Stores</th><th>Plan</th><th>Staff Limit</th><th>Ends</th><th>Status</th><th class="text-end">Actions</th>
        </tr>
        </thead>
        <tbody>
        @foreach (var c in Model)
        {
            var expired = c.SubscriptionEndDate < DateTime.UtcNow;
            <tr>
                <td>
                    <div class="fw-semibold">@c.Name</div>
                    <div class="small text-muted">@c.OwnerEmail</div>
                    <div class="small text-muted">License: @c.LicenseKey</div>
                </td>
                <td>@c.Stores.Count</td>
                <td>@c.PlanName</td>
                <td>
                    <form asp-action="UpdateStaffLimit" asp-route-id="@c.Id" method="post" class="d-flex gap-1">
                        <input name="maxStaffUsers" type="number" min="1" value="@c.MaxStaffUsers" class="form-control form-control-sm" style="width:70px;" />
                        <button class="btn btn-sm btn-outline-primary">Save</button>
                    </form>
                </td>
                <td>@c.SubscriptionEndDate.ToString("dd MMM yyyy")</td>
                <td>
                    @if (!c.IsActive) { <span class="badge bg-secondary">Disabled</span> }
                    else if (expired) { <span class="badge bg-danger">Expired</span> }
                    else { <span class="badge bg-success">Active</span> }
                </td>
                <td class="text-end">
                    <form asp-action="Extend" asp-route-id="@c.Id" method="post" class="d-inline">
                        <select name="months" class="form-select form-select-sm d-inline-block" style="width:auto;">
                            <option value="1">+1 month</option>
                            <option value="3">+3 months</option>
                            <option value="6">+6 months</option>
                            <option value="12">+12 months</option>
                        </select>
                        <button class="btn btn-sm btn-primary">Renew</button>
                    </form>
                    @if (c.IsActive)
                    {
                        <form asp-action="Disable" asp-route-id="@c.Id" method="post" class="d-inline">
                            <button class="btn btn-sm btn-outline-danger">Disable</button>
                        </form>
                    }
                    else
                    {
                        <form asp-action="Enable" asp-route-id="@c.Id" method="post" class="d-inline">
                            <button class="btn btn-sm btn-outline-success">Enable</button>
                        </form>
                    }
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>

@model Sale
@using BillOra.Domain.Enums
@{
    Layout = null;
    var store = (Store)ViewBag.Store;
    var cfg = (InvoiceSettings)ViewBag.InvoiceSettings;
    bool isDuplicate = ViewBag.IsDuplicate;
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>@cfg.InvoiceHeading @Model.InvoiceNumber</title>
    <style>
        body { font-family: Arial, sans-serif; font-size: 14px; color: #222; max-width: 800px; margin: 30px auto; position: relative; }
        .header { display: flex; justify-content: space-between; align-items: flex-start; border-bottom: 2px solid #333; padding-bottom: 12px; margin-bottom: 4px; }
        .store-name { font-size: 22px; font-weight: bold; }
        .invoice-heading { text-align: center; font-size: 20px; font-weight: 700; margin: 4px 0 16px; text-transform: uppercase; }
        .logo { max-height: 60px; margin-bottom: 6px; }
        table { width: 100%; border-collapse: collapse; margin-top: 12px; }
        th, td { border: 1px solid #ddd; padding: 8px; text-align: left; }
        th { background: #f5f6fb; }
        .text-end { text-align: right; }
        .totals { width: 320px; margin-left: auto; margin-top: 16px; }
        .totals td { border: none; padding: 4px 8px; }
        .grand-total { font-size: 18px; font-weight: bold; border-top: 2px solid #333; }
        .gst-box { width: 320px; margin-top: 12px; }
        .gst-box td { border: 1px solid #ddd; padding: 6px 10px; font-size: 13px; }
        .footer-row { display: flex; justify-content: space-between; align-items: flex-end; margin-top: 24px; }
        .duplicate-watermark {
            position: absolute; top: 40%; left: 50%; transform: translate(-50%, -50%) rotate(-30deg);
            font-size: 64px; color: rgba(200,0,0,0.15); font-weight: 900; letter-spacing: 4px;
            pointer-events: none; z-index: 0; white-space: nowrap;
        }
        @@media print { .no-print { display: none; } }
    </style>
</head>
<body onload="window.print()">
    @if (isDuplicate)
    {
        <div class="duplicate-watermark">DUPLICATE COPY</div>
    }
    <div class="header">
        <div>
            @if (cfg.ShowStoreLogo && !string.IsNullOrEmpty(store.LogoPath))
            {
                <img class="logo" src="@store.LogoPath" /><br />
            }
            @if (cfg.ShowStoreName)
            {
                <div class="store-name">@store.Name</div>
            }
            @if (cfg.ShowStoreAddress)
            {
                <div>@store.Address</div>
            }
            <div>
                @if (cfg.ShowStorePhone)
                {
                    <text>@store.Phone</text>
                }
                @if (cfg.ShowStoreEmail && !string.IsNullOrEmpty(store.Email))
                {
                    <text> | @store.Email</text>
                }
            </div>
            @if (cfg.ShowStoreGst && !string.IsNullOrEmpty(store.GstNumber))
            {
                <div>GSTIN: @store.GstNumber</div>
            }
        </div>
        <div class="text-end">
            @if (isDuplicate)
            {
                <div style="color:#b00;font-weight:bold;">DUPLICATE COPY</div>
            }
            <div><strong>Invoice:</strong> @Model.InvoiceNumber</div>
            <div><strong>Date:</strong> @Model.SaleDate.ToLocalTime().ToString("dd MMM yyyy hh:mm tt")</div>
            @if (cfg.ShowCustomerName)
            {
                <div><strong>Customer:</strong> @(Model.Customer?.Name ?? "Walk-in")</div>
            }
            @if (cfg.ShowCustomerPhone && !string.IsNullOrEmpty(Model.Customer?.Phone))
            {
                <div>@Model.Customer.Phone</div>
            }
            @if (cfg.ShowCustomerAddress && !string.IsNullOrEmpty(Model.Customer?.Address))
            {
                <div>@Model.Customer.Address</div>
            }
            @if (cfg.ShowCustomerGst && !string.IsNullOrEmpty(Model.Customer?.GstNumber))
            {
                <div>GSTIN: @Model.Customer.GstNumber</div>
            }
            @if (!string.IsNullOrEmpty(Model.TableNumber))
            {
                <div><strong>Table:</strong> @Model.TableNumber</div>
            }
            @if (!string.IsNullOrEmpty(Model.WaiterName))
            {
                <div><strong>Waiter:</strong> @Model.WaiterName</div>
            }
        </div>
    </div>

    <div class="invoice-heading">@cfg.InvoiceHeading</div>

    <table>
        <thead>
            <tr><th>#</th><th>Item</th><th class="text-end">Qty</th><th class="text-end">Unit Price</th><th class="text-end">GST%</th><th class="text-end">Line Total</th></tr>
        </thead>
        <tbody>
        @{ int rowNum = 1; }
        @foreach (var line in Model.SaleItems)
        {
            <tr>
                <td>@rowNum</td>
                <td>@line.Item?.Name</td>
                <td class="text-end">@line.Quantity</td>
                <td class="text-end">₹@line.UnitPrice.ToString("N2")</td>
                <td class="text-end">@line.GstPercent%</td>
                <td class="text-end">₹@line.LineTotal.ToString("N2")</td>
            </tr>
            rowNum++;
        }
        </tbody>
    </table>

    @if (cfg.ShowGstDetails && Model.TaxAmount > 0)
    {
        <table class="gst-box">
            <tr><td>Taxable Amount</td><td class="text-end">₹@Model.TaxableAmount.ToString("N2")</td></tr>
            @if (Model.IsInterState)
            {
                <tr><td>IGST</td><td class="text-end">₹@Model.IgstAmount.ToString("N2")</td></tr>
            }
            else
            {
                <tr><td>CGST</td><td class="text-end">₹@Model.CgstAmount.ToString("N2")</td></tr>
                <tr><td>SGST</td><td class="text-end">₹@Model.SgstAmount.ToString("N2")</td></tr>
            }
            <tr><td><strong>Total GST</strong></td><td class="text-end"><strong>₹@Model.TaxAmount.ToString("N2")</strong></td></tr>
        </table>
    }

    <table class="totals">
        <tr><td>Subtotal</td><td class="text-end">₹@Model.SubTotal.ToString("N2")</td></tr>
        <tr><td>Discount</td><td class="text-end">₹@Model.DiscountAmount.ToString("N2")</td></tr>
        <tr><td>Tax</td><td class="text-end">₹@Model.TaxAmount.ToString("N2")</td></tr>
        <tr class="grand-total"><td>Grand Total</td><td class="text-end">₹@Model.GrandTotal.ToString("N2")</td></tr>
    </table>

    @if (Model.Payments.Any())
    {
        <table class="totals">
            @foreach (var p in Model.Payments)
            {
                <tr><td>@(p.PaymentMode?.Name ?? "Payment")</td><td class="text-end">₹@p.Amount.ToString("N2")</td></tr>
            }
            @if (Model.AmountPaid < Model.GrandTotal)
            {
                <tr><td><strong>Balance Due</strong></td><td class="text-end"><strong>₹@((Model.GrandTotal - Model.AmountPaid).ToString("N2"))</strong></td></tr>
            }
        </table>
    }
    else if (Model.PaymentStatus == PaymentStatus.Unpaid)
    {
        <p class="text-end"><strong>CREDIT SALE — Amount Due: ₹@Model.GrandTotal.ToString("N2")</strong></p>
    }

    <div class="footer-row">
        <div>
            @if (cfg.ShowTermsAndConditions && !string.IsNullOrEmpty(cfg.TermsAndConditionsText))
            {
                <p style="font-size:12px; max-width:400px;"><strong>Terms &amp; Conditions:</strong><br />@cfg.TermsAndConditionsText</p>
            }
        </div>
        @if (cfg.ShowQrCode)
        {
            <img src="https://api.qrserver.com/v1/create-qr-code/?size=110x110&data=@Uri.EscapeDataString($"Invoice {Model.InvoiceNumber} | {store.Name} | Total Rs.{Model.GrandTotal:N2}")" />
        }
    </div>

    @if (!string.IsNullOrEmpty(cfg.FooterMessage))
    {
        <p style="margin-top:20px; text-align:center; color:#666;">@cfg.FooterMessage</p>
    }
    <div class="no-print" style="text-align:center; margin-top:10px;">
        <a href="/POS">Back to POS</a> &nbsp;|&nbsp; <a href="/Sales/Details/@Model.Id">Invoice Options (Email / WhatsApp)</a>
    </div>
</body>
</html>

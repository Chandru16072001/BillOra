@{
    ViewData["Title"] = "POS Billing";
    var items = (IEnumerable<Item>)ViewBag.Items;
    var paymentModes = (IEnumerable<PaymentMode>)ViewBag.PaymentModes;
    var customers = (IEnumerable<Customer>)ViewBag.Customers;
    bool gstEnabled = ViewBag.GstEnabled;
}

@Html.AntiForgeryToken()

<div class="pos-grid">
    <div>
        <div class="bo-card mb-3">
            <input id="itemSearch" class="form-control form-control-lg" placeholder="Search by name, code, or scan barcode..." autofocus />
        </div>
        <div id="itemGrid" class="row g-2">
            @foreach (var i in items)
            {
                <div class="col-6 col-md-4 col-lg-3">
                    <div class="pos-item-card"
                         onclick="addToCart(@i.Id, '@i.Name.Replace("'", "\\'")', @i.SellingPrice.ToString(System.Globalization.CultureInfo.InvariantCulture), @i.GstPercent.ToString(System.Globalization.CultureInfo.InvariantCulture))">
                        @if (!string.IsNullOrEmpty(i.ImagePath))
                        {
                            <img src="@i.ImagePath" class="pos-item-thumb" alt="@i.Name" />
                        }
                        else
                        {
                            <div class="pos-item-thumb pos-item-thumb-placeholder"><i class="fa-solid fa-image"></i></div>
                        }
                        <div class="fw-semibold">@i.Name</div>
                        <div class="text-muted small">Stock: @i.CurrentStock</div>
                        <div class="text-primary fw-bold">₹@i.SellingPrice.ToString("N2")</div>
                    </div>
                </div>
            }
        </div>
    </div>

    <div>
        <div class="bo-card">
            <h5 class="mb-3"><i class="fa-solid fa-cart-shopping"></i> Current Bill</h5>

            <div class="mb-2">
                <label class="form-label small mb-1">Customer</label>
                <div class="d-flex gap-1">
                    <select id="customerSelect" class="form-select form-select-sm">
                        <option value="">Walk-in Customer</option>
                        @foreach (var c in customers)
                        {
                            <option value="@c.Id">@c.Name @(string.IsNullOrEmpty(c.Phone) ? "" : $"({c.Phone})")</option>
                        }
                    </select>
                    <button class="btn btn-sm btn-outline-primary" type="button" data-bs-toggle="modal" data-bs-target="#newCustomerModal" title="Add new customer">
                        <i class="fa-solid fa-user-plus"></i>
                    </button>
                </div>
            </div>

            <div id="cartLines" style="max-height:300px; overflow-y:auto;">
                <p class="text-muted small" id="emptyCartMsg">No items added yet.</p>
            </div>

            <hr />

            <div class="d-flex justify-content-between small">
                <span>Subtotal</span><span id="subTotal">₹0.00</span>
            </div>
            @if (gstEnabled)
            {
                <div class="d-flex justify-content-between small">
                    <span>GST</span><span id="taxTotal">₹0.00</span>
                </div>
            }
            <div class="mb-2 mt-2">
                <label class="form-label small mb-1">Overall Discount (₹)</label>
                <input id="overallDiscount" type="number" min="0" value="0" class="form-control form-control-sm" oninput="renderCart()" />
            </div>
            <div class="d-flex justify-content-between fw-bold fs-5 mt-2">
                <span>Total</span><span id="grandTotal">₹0.00</span>
            </div>

            <div class="mb-2 mt-3">
                <label class="form-label small mb-1">Payment Mode</label>
                <select id="paymentMode" class="form-select form-select-sm">
                    @foreach (var p in paymentModes)
                    {
                        <option value="@p.Id">@p.Name</option>
                    }
                </select>
            </div>

            <div class="d-grid gap-2 mt-3">
                <button class="btn btn-primary btn-lg" onclick="checkout(false)"><i class="fa-solid fa-check"></i> Complete Sale</button>
                <button class="btn btn-outline-secondary" onclick="checkout(true)"><i class="fa-solid fa-pause"></i> Hold Bill</button>
            </div>
        </div>
    </div>
</div>

<!-- Quick "Create Customer" popup -- lets the cashier add a walk-in as a
     real customer record without leaving the billing screen (SRS 8). -->
<div class="modal fade" id="newCustomerModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">New Customer</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="mb-2">
                    <label class="form-label small">Name</label>
                    <input id="newCustName" class="form-control" required />
                </div>
                <div class="mb-2">
                    <label class="form-label small">Phone</label>
                    <input id="newCustPhone" class="form-control" />
                </div>
                <div class="mb-2">
                    <label class="form-label small">Email</label>
                    <input id="newCustEmail" class="form-control" />
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" onclick="createCustomer()">Save Customer</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
let cart = [];
const gstEnabled = @Html.Raw(gstEnabled.ToString().ToLower());

function addToCart(id, name, price, gstPercent) {
    const existing = cart.find(l => l.itemId === id);
    if (existing) { existing.quantity += 1; }
    else { cart.push({ itemId: id, name: name, unitPrice: price, quantity: 1, discount: 0, gstPercent: gstPercent }); }
    renderCart();
}

function removeLine(idx) { cart.splice(idx, 1); renderCart(); }

function updateQty(idx, qty) {
    qty = parseFloat(qty);
    if (isNaN(qty) || qty <= 0) { cart.splice(idx, 1); } else { cart[idx].quantity = qty; }
    renderCart();
}

function updateDiscount(idx, discount) {
    discount = parseFloat(discount);
    cart[idx].discount = isNaN(discount) ? 0 : discount;
    renderCart();
}

function updatePrice(idx, price) {
    price = parseFloat(price);
    cart[idx].unitPrice = isNaN(price) ? 0 : price;
    renderCart();
}

function renderCart() {
    const container = document.getElementById('cartLines');

    if (cart.length === 0) {
        container.innerHTML = '<p class="text-muted small" id="emptyCartMsg">No items added yet.</p>';
        document.getElementById('subTotal').innerText = '₹0.00';
        if (document.getElementById('taxTotal')) document.getElementById('taxTotal').innerText = '₹0.00';
        document.getElementById('grandTotal').innerText = '₹0.00';
        return;
    }

    let subTotal = 0, taxTotal = 0;
    let html = '';

    cart.forEach((line, idx) => {
        const lineBase = (line.unitPrice * line.quantity) - line.discount;
        const lineTax = gstEnabled ? (lineBase * line.gstPercent / 100) : 0;
        subTotal += lineBase;
        taxTotal += lineTax;

        html += `
            <div class="pos-cart-line">
                <div class="d-flex justify-content-between">
                    <span class="fw-semibold">${line.name}</span>
                    <button class="btn btn-sm btn-link text-danger p-0" onclick="removeLine(${idx})"><i class="fa-solid fa-xmark"></i></button>
                </div>
                <div class="d-flex align-items-center gap-1 mt-1">
                    <div>
                        <label class="text-muted" style="font-size:10px;">Qty</label>
                        <input type="number" min="0.01" step="0.01" value="${line.quantity}" class="form-control form-control-sm" style="width:60px" onchange="updateQty(${idx}, this.value)" />
                    </div>
                    <div>
                        <label class="text-muted" style="font-size:10px;">Price</label>
                        <input type="number" min="0" step="0.01" value="${line.unitPrice}" class="form-control form-control-sm" style="width:75px" onchange="updatePrice(${idx}, this.value)" />
                    </div>
                    <div>
                        <label class="text-muted" style="font-size:10px;">Discount</label>
                        <input type="number" min="0" step="0.01" value="${line.discount}" class="form-control form-control-sm" style="width:70px" onchange="updateDiscount(${idx}, this.value)" />
                    </div>
                    <div class="ms-auto text-end">
                        <label class="text-muted d-block" style="font-size:10px;">Line Total</label>
                        <span class="fw-semibold">₹${(lineBase + lineTax).toFixed(2)}</span>
                    </div>
                </div>
            </div>`;
    });

    container.innerHTML = html;

    const overallDiscount = parseFloat(document.getElementById('overallDiscount').value) || 0;
    const grandTotalRaw = subTotal - overallDiscount + taxTotal;
    const grandTotal = Math.round(grandTotalRaw);

    document.getElementById('subTotal').innerText = '₹' + subTotal.toFixed(2);
    if (document.getElementById('taxTotal')) document.getElementById('taxTotal').innerText = '₹' + taxTotal.toFixed(2);
    document.getElementById('grandTotal').innerText = '₹' + grandTotal.toFixed(2);
}

document.getElementById('itemSearch').addEventListener('input', async function () {
    const term = this.value;
    if (!term) return;
    const res = await fetch('/POS/SearchItems?term=' + encodeURIComponent(term));
    const results = await res.json();
    const grid = document.getElementById('itemGrid');
    grid.innerHTML = '';
    results.forEach(i => {
        const thumb = i.imagePath
            ? `<img src="${i.imagePath}" class="pos-item-thumb" alt="${i.name}" />`
            : `<div class="pos-item-thumb pos-item-thumb-placeholder"><i class="fa-solid fa-image"></i></div>`;
        grid.innerHTML += `
            <div class="col-6 col-md-4 col-lg-3">
                <div class="pos-item-card" onclick="addToCart(${i.id}, '${i.name.replace("'", "\\'")}', ${i.sellingPrice}, ${i.gstPercent})">
                    ${thumb}
                    <div class="fw-semibold">${i.name}</div>
                    <div class="text-muted small">Stock: ${i.currentStock}</div>
                    <div class="text-primary fw-bold">₹${i.sellingPrice.toFixed(2)}</div>
                </div>
            </div>`;
    });
});

function getAntiForgeryToken() {
    return document.querySelector('input[name="__RequestVerificationToken"]')?.value;
}

async function createCustomer() {
    const name = document.getElementById('newCustName').value.trim();
    if (!name) { alert('Name is required.'); return; }

    const form = new FormData();
    form.append('Name', name);
    form.append('Phone', document.getElementById('newCustPhone').value);
    form.append('Email', document.getElementById('newCustEmail').value);
    form.append('__RequestVerificationToken', getAntiForgeryToken());

    const res = await fetch('/Customers/Create', {
        method: 'POST',
        headers: { 'X-Requested-With': 'XMLHttpRequest' },
        body: form
    });

    if (res.ok) {
        const customer = await res.json();
        const select = document.getElementById('customerSelect');
        const opt = document.createElement('option');
        opt.value = customer.id;
        opt.text = customer.name + (customer.phone ? ' (' + customer.phone + ')' : '');
        select.appendChild(opt);
        select.value = customer.id;

        document.getElementById('newCustName').value = '';
        document.getElementById('newCustPhone').value = '';
        document.getElementById('newCustEmail').value = '';
        bootstrap.Modal.getInstance(document.getElementById('newCustomerModal')).hide();
    } else {
        alert('Could not save the customer. Please try again.');
    }
}

async function checkout(hold) {
    if (cart.length === 0) { alert('Add at least one item.'); return; }

    const payload = {
        customerId: document.getElementById('customerSelect').value || null,
        paymentModeId: document.getElementById('paymentMode').value || null,
        overallDiscount: parseFloat(document.getElementById('overallDiscount').value) || 0,
        lines: cart.map(l => ({ itemId: l.itemId, quantity: l.quantity, unitPrice: l.unitPrice, discount: l.discount }))
    };

    const res = await fetch('/POS/CreateSale?hold=' + hold, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': getAntiForgeryToken() || '' },
        body: JSON.stringify(payload)
    });

    if (res.ok) {
        const result = await res.json();
        if (hold) {
            alert('Bill held as ' + result.invoiceNumber);
            cart = []; renderCart();
        } else {
            window.location.href = '/POS/Print/' + result.saleId;
        }
    } else {
        alert('Could not save the bill. Please try again.');
    }
}
</script>
}

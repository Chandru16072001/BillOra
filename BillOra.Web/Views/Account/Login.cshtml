@inject BillOra.Application.Common.Interfaces.IBrandingService BrandingService
@{
    var branding = await BrandingService.GetAsync();
}
@{
    ViewData["Title"] = "Login";
    Layout = "_Layout";
}
<div class="d-flex align-items-center justify-content-center" style="min-height:80vh;">
    <div class="bo-card" style="width:100%; max-width:380px;">
        <h3 class="mb-1 d-flex align-items-center gap-2">
            @if (!string.IsNullOrEmpty(branding.LogoPath))
            {
                <img src="@branding.LogoPath" style="height:32px;" alt="@branding.SoftwareName" />
            }
            else
            {
                <i class="fa-solid fa-receipt text-primary"></i>
            }
            @branding.SoftwareName
        </h3>
        @if (!string.IsNullOrEmpty(branding.Tagline))
        {
            <p class="text-muted small mb-1">@branding.Tagline</p>
        }
        <p class="text-muted mb-4">Sign in to continue</p>


        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-danger py-2">
                @foreach (var err in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <div>@err.ErrorMessage</div>
                }
            </div>
        }

        <form method="post" asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]">
            <div class="mb-3">
                <label class="form-label">Email</label>
                <input type="email" name="email" class="form-control" required />
            </div>
            <div class="mb-3">
                <label class="form-label">Password</label>
                <input type="password" name="password" class="form-control" required />
            </div>
            <div class="form-check mb-3">
                <input class="form-check-input" type="checkbox" name="rememberMe" value="true" id="rm" />
                <label class="form-check-label" for="rm">Remember me</label>
            </div>
            <button class="btn btn-primary w-100" type="submit">Login</button>
        </form>

        <hr />
        <p class="small text-muted mb-1">Demo logins:</p>
        <p class="small text-muted mb-0">Developer: dev@billora.local / Dev@12345</p>
        <p class="small text-muted mb-0">Store Admin: admin@billora.local / Admin@12345</p>
        <p class="small text-muted">Cashier: cashier@billora.local / Cashier@12345</p>
    </div>
</div>

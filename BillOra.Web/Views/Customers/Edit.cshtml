@model Customer
@{ ViewData["Title"] = "Edit Customer"; }

<h3 class="mb-4">Edit Customer</h3>

<div class="bo-card" style="max-width:680px;">
    <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
        <input type="hidden" asp-for="Id" />
        <div class="row g-3">
            <div class="col-md-6">
                <label class="form-label">Name</label>
                <input asp-for="Name" class="form-control" required />
            </div>
            <div class="col-md-3">
                <label class="form-label">Phone</label>
                <input asp-for="Phone" class="form-control" />
            </div>
            <div class="col-md-3">
                <label class="form-label">Email</label>
                <input asp-for="Email" class="form-control" />
            </div>
            <div class="col-md-4">
                <label class="form-label">GST Number</label>
                <input asp-for="GstNumber" class="form-control" />
            </div>
 <div class="col-md-4"> <select name="CustomerType" class="form-control">
                    <option value="WalkIn">Walk-in</option>
                    <option value="Regular" selected>Regular</option>
                    <option value="Contractor">Contractor</option>
                    <option value="Builder">Builder</option>
                </select></div>
            <div class="col-md-4">
                <label class="form-label">Credit Limit</label>
                <input asp-for="CreditLimit" type="number" step="0.01" class="form-control" />
            </div>
            <div class="col-md-4 d-flex align-items-end">
                <div class="form-check">
                    <input asp-for="IsActive" class="form-check-input" type="checkbox" />
                    <label class="form-check-label">Active</label>
                </div>
            </div>
            <div class="col-12"><hr /></div>
            <div class="col-md-8">
                <label class="form-label">Address</label>
                <input asp-for="Address" class="form-control" />
            </div>
            <div class="col-md-4">
                <label class="form-label">PIN Code</label>
                <input asp-for="PinCode" class="form-control" />
            </div>
            <div class="col-md-4">
                <label class="form-label">District</label>
                <input asp-for="District" class="form-control" />
            </div>
            <div class="col-md-4">
                <label class="form-label">Taluk</label>
                <input asp-for="Taluk" class="form-control" />
            </div>
            <div class="col-md-2">
                <label class="form-label">State</label>
                <input asp-for="State" class="form-control" />
                <div class="form-text">Drives CGST+SGST vs IGST</div>
            </div>
            <div class="col-md-2">
                <label class="form-label">Country</label>
                <input asp-for="Country" class="form-control" />
            </div>
        </div>
        <div class="mt-4">
            <button class="btn btn-primary" type="submit">Save Changes</button>
            <a class="btn btn-outline-secondary" href="/Customers">Cancel</a>
        </div>
    </form>
</div>

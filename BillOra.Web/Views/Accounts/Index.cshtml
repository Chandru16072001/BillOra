@using BillOra.Domain.Enums
@model object
@{
    ViewData["Title"] = "Accounts";
    var recent = (List<AccountTransaction>)ViewBag.RecentTransactions;
}

@if (TempData["Success"] != null) { <div class="alert alert-success py-2">@TempData["Success"]</div> }
@if (TempData["Error"] != null) { <div class="alert alert-danger py-2">@TempData["Error"]</div> }

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3>Mini Accounts — New Transaction</h3>
    <div class="d-flex gap-2">
        <a class="btn btn-outline-secondary" href="/Accounts/History"><i class="fa-solid fa-clock-rotate-left"></i> History</a>
        <a class="btn btn-outline-secondary" href="/Accounts/BalanceSheet"><i class="fa-solid fa-scale-balanced"></i> Balance Sheet</a>
    </div>
</div>

<div class="bo-card mb-4" style="max-width:720px;">
    <form asp-action="Create" method="post" enctype="multipart/form-data">
        <div class="row g-3">
            <div class="col-md-6">
                <label class="form-label">Transaction Date</label>
                <input type="datetime-local" name="transactionDate" value="@DateTime.Now.ToString("yyyy-MM-ddTHH:mm")" class="form-control" />
            </div>
            <div class="col-md-6">
                <label class="form-label">Transaction Name</label>
                <input name="transactionName" class="form-control" required />
            </div>
            <div class="col-md-4">
                <label class="form-label">Amount</label>
                <input name="amount" type="number" step="0.01" min="0.01" class="form-control" required />
            </div>
            <div class="col-md-4">
                <label class="form-label">Type</label>
                <select name="type" class="form-select">
                    <option value="@TransactionDirection.Credit">Credit</option>
                    <option value="@TransactionDirection.Debit">Debit</option>
                </select>
            </div>
            <div class="col-md-4">
                <label class="form-label">Payment Method</label>
                <select name="paymentMethod" class="form-select">
                    <option>Cash</option><option>UPI</option><option>Card</option><option>Bank Transfer</option><option>Other</option>
                </select>
            </div>
            <div class="col-md-6">
                <label class="form-label">Category</label>
                <input name="category" class="form-control" placeholder="e.g. Expense, Income, Rent, Salary" />
            </div>
            <div class="col-md-6">
                <label class="form-label">Reference Number</label>
                <input name="referenceNumber" class="form-control" />
            </div>
            <div class="col-md-6">
                <label class="form-label">Reason</label>
                <input name="reason" class="form-control" />
            </div>
            <div class="col-md-6">
                <label class="form-label">Attachment (optional)</label>
                <input type="file" name="attachment" class="form-control" />
            </div>
            <div class="col-12">
                <label class="form-label">Notes / Remarks</label>
                <textarea name="notes" class="form-control" rows="2"></textarea>
            </div>
        </div>
        <button class="btn btn-primary mt-3" type="submit">Save Transaction</button>
    </form>
</div>

<div class="bo-card">
    <h5>Recent Transactions</h5>
    <table class="table table-sm mt-2">
        <thead><tr><th>Date</th><th>Name</th><th>Category</th><th>Type</th><th class="text-end">Amount</th></tr></thead>
        <tbody>
        @foreach (var t in recent)
        {
            <tr>
                <td>@t.TransactionDate.ToLocalTime().ToString("dd MMM yyyy hh:mm tt")</td>
                <td>@t.TransactionName</td>
                <td>@t.Category</td>
                <td><span class="badge @(t.Type == TransactionDirection.Credit ? "bg-success" : "bg-danger")">@t.Type</span></td>
                <td class="text-end">₹@t.Amount.ToString("N2")</td>
            </tr>
        }
        </tbody>
    </table>
</div>

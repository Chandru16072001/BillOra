@model Item
@{ ViewData["Title"] = "Edit Item"; }
<h3 class="mb-4">Edit Item</h3>
<div class="bo-card" style="max-width:720px;">
    <form asp-action="Edit" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data">
        <input type="hidden" asp-for="Id" />
        <div class="row g-3">
            <div class="col-md-6">
                <label class="form-label">Product Image</label>
                @if (!string.IsNullOrEmpty(Model.ImagePath))
                {
                    <div class="mb-2"><img src="@Model.ImagePath" style="max-height:100px; border-radius:8px;" /></div>
                }
                <input type="file" name="imageFile" accept="image/*" class="form-control" onchange="previewImage(event)" />
                <img id="imgPreview" src="" style="display:none; max-height:120px; margin-top:8px; border-radius:8px;" />
            </div>
            <div class="col-md-6">
                <label class="form-label">Item Name</label>
                <input asp-for="Name" class="form-control" required />
            </div>
            <div class="col-md-3">
                <label class="form-label">Item Code</label>
                <input asp-for="ItemCode" class="form-control" />
            </div>
            <div class="col-md-3">
                <label class="form-label">Barcode</label>
                <input asp-for="Barcode" class="form-control" />
            </div>
            <div class="col-md-4">
                <label class="form-label">Category</label>
                <select asp-for="CategoryId" class="form-select">
                    <option value="">-- none --</option>
                    @foreach (var c in (IEnumerable<Category>)ViewBag.Categories)
                    {
                        <option value="@c.Id" selected="@(c.Id == Model.CategoryId)">@c.Name</option>
                    }
                </select>
            </div>
            <div class="col-md-4">
                <label class="form-label">Unit</label>
                <select asp-for="UnitId" class="form-select">
                    <option value="">-- none --</option>
                    @foreach (var u in (IEnumerable<UnitOfMeasure>)ViewBag.Units)
                    {
                        <option value="@u.Id" selected="@(u.Id == Model.UnitId)">@u.Name (@u.ShortCode)</option>
                    }
                </select>
            </div>
            <div class="col-md-4">
                <label class="form-label">HSN Code</label>
                <input asp-for="HsnCode" class="form-control" />
            </div>
            <div class="col-md-3">
                <label class="form-label">GST %</label>
                <input asp-for="GstPercent" type="number" step="0.01" class="form-control" />
            </div>
            <div class="col-md-3">
                <label class="form-label">Purchase Price</label>
                <input asp-for="PurchasePrice" type="number" step="0.01" class="form-control" />
            </div>
            <div class="col-md-3">
                <label class="form-label">Selling Price</label>
                <input asp-for="SellingPrice" type="number" step="0.01" class="form-control" required />
            </div>
            <div class="col-md-3">
                <label class="form-label">Min Selling Price</label>
                <input asp-for="MinSellingPrice" type="number" step="0.01" class="form-control" />
            </div>
            <div class="col-md-4">
                <label class="form-label">Current Stock (read-only, adjust via Inventory)</label>
                <input value="@Model.CurrentStock" class="form-control" disabled />
            </div>
            <div class="col-md-4">
                <label class="form-label">Reorder Level</label>
                <input asp-for="ReorderLevel" type="number" step="0.01" class="form-control" />
            </div>
            <div class="col-md-4 d-flex align-items-end">
                <div class="form-check">
                    <input asp-for="IsActive" class="form-check-input" type="checkbox" />
                    <label class="form-check-label">Active</label>
                </div>
            </div>
        </div>
        <div class="mt-4">
            <button class="btn btn-primary" type="submit">Save Changes</button>
            <a class="btn btn-outline-secondary" href="/Items">Cancel</a>
        </div>
    </form>
</div>

<script>
function previewImage(event) {
    const preview = document.getElementById('imgPreview');
    const file = event.target.files[0];
    if (!file) { preview.style.display = 'none'; return; }
    preview.src = URL.createObjectURL(file);
    preview.style.display = 'block';
}
</script>

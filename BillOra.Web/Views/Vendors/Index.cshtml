@model List<Vendor>
@{ ViewData["Title"] = "Vendors"; }

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3>Vendor Master</h3>
</div>

<div class="bo-card mb-4">
    <form asp-action="Create" method="post" class="row g-2">
        <div class="col-md-3"><input name="Name" class="form-control" placeholder="Vendor Name" required /></div>
        <div class="col-md-2"><input name="Phone" class="form-control" placeholder="Phone" /></div>
        <div class="col-md-2"><input name="GstNumber" class="form-control" placeholder="GST Number" /></div>
        <div class="col-md-3"><input name="Address" class="form-control" placeholder="Address" /></div>
        <div class="col-md-2"><button class="btn btn-primary w-100"><i class="fa-solid fa-plus"></i> Add Vendor</button></div>
    </form>
</div>

<div class="bo-card mb-3">
    <form method="get" class="row g-2">
        <div class="col-auto flex-grow-1">
            <input type="text" name="search" value="@ViewBag.Search" class="form-control" placeholder="Search by name or phone" />
        </div>
        <div class="col-auto"><button class="btn btn-outline-secondary">Search</button></div>
    </form>
</div>

<div class="bo-card">
    <table class="table align-middle">
        <thead><tr><th>Name</th><th>Phone</th><th>GST No.</th><th>Address</th><th>Status</th><th class="text-end">Actions</th></tr></thead>
        <tbody>
        @foreach (var v in Model)
        {
            <tr>
                <td>@v.Name</td>
                <td>@v.Phone</td>
                <td>@v.GstNumber</td>
                <td>@v.Address</td>
                <td>
                    @if (v.IsActive) { <span class="badge bg-success">Active</span> }
                    else { <span class="badge bg-secondary">Inactive</span> }
                </td>
                <td class="text-end">
                    <form asp-action="Delete" asp-route-id="@v.Id" method="post" class="d-inline" onsubmit="return confirm('Delete this vendor?');">
                        <button class="btn btn-sm btn-outline-danger">Delete</button>
                    </form>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>

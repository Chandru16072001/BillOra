@{
    ViewData["Title"] = "Opening Stock Entry";
    var items = (IEnumerable<Item>)ViewBag.Items;
    var recent = (IEnumerable<InventoryTransaction>)ViewBag.RecentEntries;
}

<h3 class="mb-4">Opening Stock Entry</h3>
<p class="text-muted">Use this to add stock directly for an item — separate from receiving stock via a vendor GRN.</p>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success py-2">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger py-2">@TempData["Error"]</div>
}

<div class="bo-card mb-4" style="max-width:600px;">
    <form asp-action="OpeningStock" method="post">
        <div class="mb-3">
            <label class="form-label">Item</label>
            <select name="itemId" class="form-select" required>
                <option value="">-- select item --</option>
                @foreach (var i in items)
                {
                    <option value="@i.Id">@i.Name (current: @i.CurrentStock)</option>
                }
            </select>
        </div>
        <div class="mb-3">
            <label class="form-label">Quantity to Add</label>
            <input name="quantity" type="number" step="0.01" min="0.01" class="form-control" required />
        </div>
        <div class="mb-3">
            <label class="form-label">Notes (optional)</label>
            <input name="notes" class="form-control" placeholder="e.g. initial stock load" />
        </div>
        <button class="btn btn-primary" type="submit">Add Stock</button>
    </form>
</div>

<div class="bo-card">
    <h5>Recent Opening Stock Entries</h5>
    <table class="table table-sm mt-3">
        <thead><tr><th>Item</th><th class="text-end">Qty Added</th><th class="text-end">Balance After</th><th>Date</th><th>Notes</th></tr></thead>
        <tbody>
        @foreach (var t in recent)
        {
            <tr>
                <td>@t.Item?.Name</td>
                <td class="text-end">@t.Quantity</td>
                <td class="text-end">@t.BalanceAfter</td>
                <td>@t.TransactionDate.ToLocalTime().ToString("dd MMM yyyy hh:mm tt")</td>
                <td>@t.Notes</td>
            </tr>
        }
        </tbody>
    </table>
</div>

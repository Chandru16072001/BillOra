@using BillOra.Shared.Constants
@{
    ViewData["Title"] = "Add Staff";
    var moduleKeys = (string[])ViewBag.ModuleKeys;
}

<h3 class="mb-4">Add Staff</h3>

<div class="bo-card" style="max-width:640px;">
    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger py-2">
            @foreach (var err in ViewData.ModelState.Values.SelectMany(v => v.Errors))
            {
                <div>@err.ErrorMessage</div>
            }
        </div>
    }
    <form method="post">
        <div class="row g-3 mb-3">
            <div class="col-md-6">
                <label class="form-label">Full Name</label>
                <input name="fullName" class="form-control" required />
            </div>
            <div class="col-md-6">
                <label class="form-label">Email (used as login)</label>
                <input name="email" type="email" class="form-control" required />
            </div>
            <div class="col-md-6">
                <label class="form-label">Password</label>
                <input name="password" type="text" class="form-control" required />
            </div>
            <div class="col-md-6">
                <label class="form-label">Role</label>
                <select name="role" class="form-select" required>
                    <option value="@Roles.Cashier">Cashier</option>
                    <option value="@Roles.Manager">Manager</option>
                </select>
            </div>
        </div>

        <h6 class="text-muted">Module Access</h6>
        <p class="small text-muted">Choose which parts of the app this staff member can reach. A billing-counter hire, for example, would get only POS Billing.</p>
        <div class="row g-2 mb-4">
            @foreach (var key in moduleKeys)
            {
                <div class="col-md-4 col-6">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" name="allowedModules" value="@key" id="mod_@key" checked />
                        <label class="form-check-label" for="mod_@key">@ModuleKeys.DisplayNames[key]</label>
                    </div>
                </div>
            }
        </div>

        <button class="btn btn-primary" type="submit">Create Staff Account</button>
        <a class="btn btn-outline-secondary" href="/Staff">Cancel</a>
    </form>
</div>

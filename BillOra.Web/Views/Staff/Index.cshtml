@using BillOra.Persistence.Identity
@model List<(ApplicationUser User, IList<string> Roles)>
@{
    ViewData["Title"] = "Staff Master";
    int maxStaff = ViewBag.MaxStaffUsers;
    int currentCount = ViewBag.CurrentStaffCount;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3>Staff Master</h3>
    <a class="btn btn-primary" href="/Staff/Create"><i class="fa-solid fa-user-plus"></i> Add Staff</a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success py-2">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger py-2">@TempData["Error"]</div>
}

<div class="bo-card mb-3">
    <div class="d-flex justify-content-between align-items-center">
        <span>Licensed staff seats used</span>
        <span class="fw-bold @(currentCount >= maxStaff ? "text-danger" : "text-success")">@currentCount / @maxStaff</span>
    </div>
    <div class="progress mt-2" style="height:8px;">
        <div class="progress-bar @(currentCount >= maxStaff ? "bg-danger" : "bg-success")" style="width:@(maxStaff > 0 ? (currentCount * 100 / maxStaff) : 0)%"></div>
    </div>
</div>

<div class="bo-card">
    <table class="table align-middle">
        <thead><tr><th>Name</th><th>Email</th><th>Role</th><th>Status</th><th class="text-end">Actions</th></tr></thead>
        <tbody>
        @foreach (var (user, roles) in Model)
        {
            var isLockedOut = user.LockoutEnd.HasValue && user.LockoutEnd > DateTimeOffset.UtcNow;
            <tr>
                <td>@user.FullName</td>
                <td>@user.Email</td>
                <td><span class="badge bg-info text-dark">@string.Join(", ", roles)</span></td>
                <td>
                    @if (isLockedOut) { <span class="badge bg-secondary">Deactivated</span> }
                    else { <span class="badge bg-success">Active</span> }
                </td>
                <td class="text-end">
                    @if (!roles.Contains("StoreAdmin"))
                    {
                        <a class="btn btn-sm btn-outline-secondary" href="/Staff/EditPermissions/@user.Id">Permissions</a>
                        @if (isLockedOut)
                        {
                            <form asp-action="Reactivate" asp-route-id="@user.Id" method="post" class="d-inline">
                                <button class="btn btn-sm btn-outline-success">Reactivate</button>
                            </form>
                        }
                        else
                        {
                            <form asp-action="Deactivate" asp-route-id="@user.Id" method="post" class="d-inline" onsubmit="return confirm('Deactivate this staff account?');">
                                <button class="btn btn-sm btn-outline-danger">Deactivate</button>
                            </form>
                        }
                    }
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>

@using BillOra.Persistence.Identity
@using BillOra.Shared.Constants
@{
    ViewData["Title"] = "Edit Permissions";
    var user = (ApplicationUser)ViewBag.User;
    var moduleKeys = (string[])ViewBag.ModuleKeys;
    var permissions = (Dictionary<string, bool>)ViewBag.Permissions;
    var roles = (IList<string>)ViewBag.Roles;
}

<h3 class="mb-1">Permissions — @user.FullName</h3>
<p class="text-muted">Role: @string.Join(", ", roles)</p>

<div class="bo-card" style="max-width:560px;">
    <form method="post">
        <div class="row g-2 mb-4">
            @foreach (var key in moduleKeys)
            {
                var allowed = !permissions.ContainsKey(key) || permissions[key];
                <div class="col-md-6">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" name="allowedModules" value="@key" id="mod_@key" checked="@allowed" />
                        <label class="form-check-label" for="mod_@key">@ModuleKeys.DisplayNames[key]</label>
                    </div>
                </div>
            }
        </div>
        <button class="btn btn-primary" type="submit">Save Permissions</button>
        <a class="btn btn-outline-secondary" href="/Staff">Cancel</a>
    </form>
</div>

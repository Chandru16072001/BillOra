@{
    ViewData["Title"] = "Subscription Expired";
    Layout = "_Layout";
}
<div class="d-flex align-items-center justify-content-center" style="min-height:70vh;">
    <div class="bo-card text-center" style="max-width:480px;">
        <i class="fa-solid fa-triangle-exclamation text-danger" style="font-size:2.5rem;"></i>
        <h3 class="mt-3">Your subscription has expired</h3>
        <p class="text-muted">Please contact the software provider to renew your access.</p>
        <form asp-controller="Account" asp-action="Logout" method="post">
            <button class="btn btn-outline-secondary mt-2" type="submit">Logout</button>
        </form>
    </div>
</div>

@model List<SalesReturn>
@{ ViewData["Title"] = "Sales Return Report"; }

<h3 class="mb-4">Sales Return Report</h3>

<div class="bo-card mb-3">
    <form method="get" class="row g-2">
        <div class="col-md-2"><label class="form-label small">From</label><input type="date" name="from" value="@ViewBag.From" class="form-control form-control-sm" /></div>
        <div class="col-md-2"><label class="form-label small">To</label><input type="date" name="to" value="@ViewBag.To" class="form-control form-control-sm" /></div>
        <div class="col-md-2"><label class="form-label small">Customer</label><input name="customer" value="@ViewBag.Customer" class="form-control form-control-sm" /></div>
        <div class="col-md-2"><label class="form-label small">Invoice #</label><input name="invoiceNumber" value="@ViewBag.InvoiceNumber" class="form-control form-control-sm" /></div>
        <div class="col-md-2"><label class="form-label small">Item</label><input name="item" value="@ViewBag.Item" class="form-control form-control-sm" /></div>
        <div class="col-md-2 d-flex align-items-end gap-2">
            <button class="btn btn-sm btn-primary w-100">Filter</button>
        </div>
    </form>
    <a class="btn btn-sm btn-outline-success mt-2" href="/SalesReturn/ExportReport?@Context.Request.QueryString.Value.TrimStart('?')">
        <i class="fa-solid fa-file-excel"></i> Export to Excel
    </a>
</div>

<div class="bo-card">
    <table class="table table-sm">
        <thead><tr><th>Invoice</th><th>Customer</th><th>Date</th><th>Reason</th><th>Load Stock</th><th class="text-end">Refund</th><th class="text-end">Actions</th></tr></thead>
        <tbody>
        @foreach (var sr in Model)
        {
            <tr>
                <td>@sr.InvoiceNumber</td>
                <td>@(sr.Customer?.Name ?? "Walk-in")</td>
                <td>@sr.ReturnDate.ToLocalTime().ToString("dd MMM yyyy")</td>
                <td>@sr.ReturnReason</td>
                <td>@(sr.LoadStock ? "Yes" : "No")</td>
                <td class="text-end">₹@sr.RefundAmount.ToString("N2")</td>
                <td class="text-end"><a class="btn btn-sm btn-outline-secondary" href="/SalesReturn/Details/@sr.Id">View</a></td>
            </tr>
        }
        </tbody>
        <tfoot><tr class="fw-bold"><td colspan="5">Total</td><td class="text-end">₹@Model.Sum(x => x.RefundAmount).ToString("N2")</td><td></td></tr></tfoot>
    </table>
</div>

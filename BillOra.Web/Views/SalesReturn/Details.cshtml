@model SalesReturn
@{ ViewData["Title"] = "Sales Return " + Model.InvoiceNumber; }

@if (TempData["Success"] != null) { <div class="alert alert-success py-2">@TempData["Success"]</div> }
@if (TempData["Error"] != null) { <div class="alert alert-danger py-2">@TempData["Error"]</div> }

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3>Sales Return — @Model.InvoiceNumber</h3>
    <div>
        <a class="btn btn-outline-secondary" href="/SalesReturn/Print/@Model.Id" target="_blank"><i class="fa-solid fa-print"></i> Print</a>
        <form asp-action="Email" asp-route-id="@Model.Id" method="post" class="d-inline">
            <button class="btn btn-outline-secondary"><i class="fa-solid fa-envelope"></i> Email</button>
        </form>
    </div>
</div>

<div class="bo-card mb-3">
    <p><strong>Customer:</strong> @(Model.Customer?.Name ?? "Walk-in")</p>
    <p><strong>Return Date:</strong> @Model.ReturnDate.ToLocalTime().ToString("dd MMM yyyy hh:mm tt")</p>
    <p><strong>Reason:</strong> @Model.ReturnReason</p>
    <p><strong>Load Stock:</strong> @(Model.LoadStock ? "Yes - restocked" : "No - not restocked")</p>
</div>

<div class="bo-card">
    <table class="table">
        <thead><tr><th>Item</th><th class="text-end">Return Qty</th><th class="text-end">Unit Price</th><th class="text-end">Refund</th></tr></thead>
        <tbody>
        @foreach (var line in Model.Items)
        {
            <tr>
                <td>@line.Item?.Name</td>
                <td class="text-end">@line.ReturnQuantity</td>
                <td class="text-end">₹@line.UnitPrice.ToString("N2")</td>
                <td class="text-end">₹@line.LineRefund.ToString("N2")</td>
            </tr>
        }
        </tbody>
    </table>
    <h5 class="text-end">Total Refund: ₹@Model.RefundAmount.ToString("N2")</h5>
</div>

@model Store
@{ ViewData["Title"] = "Store Information"; }

<h3 class="mb-4">Store Information</h3>

@if (TempData["Success"] != null) { <div class="alert alert-success py-2">@TempData["Success"]</div> }

<div class="bo-card" style="max-width:820px;">
    <form asp-action="Edit" method="post" enctype="multipart/form-data">
        <h6 class="text-muted">Business Identity</h6>
        <div class="row g-3 mb-3">
            <div class="col-md-4">
                <label class="form-label">Logo</label>
                @if (!string.IsNullOrEmpty(Model.LogoPath))
                {
                    <div class="mb-2"><img src="@Model.LogoPath" style="max-height:70px;border-radius:8px;" /></div>
                }
                <input type="file" name="logoFile" accept="image/*" class="form-control" />
            </div>
            <div class="col-md-4">
                <label class="form-label">Store Name</label>
                <input name="name" value="@Model.Name" class="form-control" required />
            </div>
            <div class="col-md-4">
                <label class="form-label">Owner Name</label>
                <input name="ownerName" value="@Model.OwnerName" class="form-control" />
            </div>
            <div class="col-md-4">
                <label class="form-label">Business Type</label>
                <select name="businessType" class="form-select">
                    @foreach (var type in new[] { "Retail", "Wholesale", "Restaurant / Food", "Pharmacy", "Supermarket", "Services", "Other" })
                    {
                        <option value="@type" selected="@(Model.BusinessType == type)">@type</option>
                    }
                </select>
            </div>
            <div class="col-md-4">
                <label class="form-label">GST Number</label>
                <input name="gstNumber" value="@Model.GstNumber" class="form-control" />
            </div>
            <div class="col-md-4">
                <label class="form-label">PAN Number</label>
                <input name="panNumber" value="@Model.PanNumber" class="form-control" />
            </div>
            <div class="col-md-4">
                <label class="form-label">FSSAI License Number <span class="text-muted small">(food businesses)</span></label>
                <input name="fssaiNumber" value="@Model.FssaiNumber" class="form-control" />
            </div>
        </div>

        <h6 class="text-muted">Contact</h6>
        <div class="row g-3 mb-3">
            <div class="col-md-4">
                <label class="form-label">Phone Number</label>
                <input name="phone" value="@Model.Phone" class="form-control" />
            </div>
            <div class="col-md-4">
                <label class="form-label">Alternate Phone Number</label>
                <input name="alternatePhone" value="@Model.AlternatePhone" class="form-control" />
            </div>
            <div class="col-md-4">
                <label class="form-label">Email</label>
                <input name="email" value="@Model.Email" class="form-control" />
            </div>
        </div>

        <h6 class="text-muted">Address</h6>
        <div class="row g-3 mb-3">
            <div class="col-md-8">
                <label class="form-label">Address</label>
                <input name="address" value="@Model.Address" class="form-control" />
            </div>
            <div class="col-md-4">
                <label class="form-label">PIN Code</label>
                <input name="pinCode" value="@Model.PinCode" class="form-control" />
            </div>
            <div class="col-md-4">
                <label class="form-label">District</label>
                <input name="district" value="@Model.District" class="form-control" />
            </div>
            <div class="col-md-4">
                <label class="form-label">Taluk</label>
                <input name="taluk" value="@Model.Taluk" class="form-control" />
            </div>
            <div class="col-md-2">
                <label class="form-label">State</label>
                <input name="state" value="@Model.State" class="form-control" />
                <div class="form-text">Used for CGST+SGST vs IGST</div>
            </div>
            <div class="col-md-2">
                <label class="form-label">Country</label>
                <input name="country" value="@Model.Country" class="form-control" />
            </div>
        </div>

        <button class="btn btn-primary" type="submit">Save Store Information</button>
    </form>
</div>

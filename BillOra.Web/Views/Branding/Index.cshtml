@model AppBranding
@{ ViewData["Title"] = "Branding"; }

<h3 class="mb-1">Application Branding</h3>
<p class="text-muted">Global — applies to every store/client across the whole application (login page, navigation, footer, print templates). Not store-specific.</p>

@if (TempData["Success"] != null) { <div class="alert alert-success py-2">@TempData["Success"]</div> }

<div class="bo-card" style="max-width:640px;">
    <form asp-action="Save" method="post" enctype="multipart/form-data">
        <div class="mb-3">
            <label class="form-label">Software Name</label>
            <input name="softwareName" value="@Model.SoftwareName" class="form-control" required />
        </div>
        <div class="mb-3">
            <label class="form-label">Tagline <span class="text-muted small">(optional)</span></label>
            <input name="tagline" value="@Model.Tagline" class="form-control" placeholder="e.g. Simple Billing &amp; POS Software" />
        </div>
        <div class="mb-3">
            <label class="form-label">Logo</label>
            @if (!string.IsNullOrEmpty(Model.LogoPath))
            {
                <div class="mb-2"><img src="@Model.LogoPath" style="max-height:60px;border-radius:8px;" /></div>
            }
            <input type="file" name="logoFile" accept="image/*" class="form-control" />
            <div class="form-text">Shown in the navbar, login page, and footer.</div>
        </div>
        <div class="mb-3">
            <label class="form-label">Favicon <span class="text-muted small">(optional)</span></label>
            @if (!string.IsNullOrEmpty(Model.FaviconPath))
            {
                <div class="mb-2"><img src="@Model.FaviconPath" style="height:24px;" /></div>
            }
            <input type="file" name="faviconFile" accept="image/x-icon,image/png,image/svg+xml" class="form-control" />
            <div class="form-text">Shown in the browser tab. PNG or ICO recommended.</div>
        </div>
        <button class="btn btn-primary" type="submit">Save Branding</button>
    </form>
</div>
